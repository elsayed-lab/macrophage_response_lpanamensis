  title = {Stress Response Pathways in Protozoan Parasites},
  author = {Vonlaufen, Nathalie and Kanzok, SM Stefan M. and Wek, Ronald C. and Sullivan, William J. and Jr, William J. Sullivan},
  year = {2008},
