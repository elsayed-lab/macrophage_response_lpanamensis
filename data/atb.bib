@article{lovkvistImportanceUntranslatedRegion2001a,
  title = {Importance of the 3' Untranslated Region of Ornithine Decarboxylase {{mRNA}} in the Translational Regulation of the Enzyme},
  author = {Lovkvist, Wallstrom E. and Takao, K. and Wendt, A. and Vargiu, C. and Yin, H. and Persson, L.},
