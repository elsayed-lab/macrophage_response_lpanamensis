  title = {Messenger {{RNA}} Translation in Prokaryotes: {{GTPase}} Centers Associated with Translational Factors},
  author = {Laalami, S. and Grentzmann, G. and Bremaud, L. and Cenatiempo, Y.},
  year = {1996},
