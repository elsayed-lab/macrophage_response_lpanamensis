  title = {Structural Basis for Nucleotide Exchange and Competition with {{tRNA}} in the Yeast Elongation Factor Complex {{eEF1A}}: {{eEF1B}} [Alpha]},
  author = {Andersen, G. R. and Pedersen, L. and Valente, L. and Chatterjee, I. and Kinzy, T. G. and Kjeldgaard, M. and Nyborg, J.},
  year = {2000},
  month = nov,
