@article{kolbergGprofiler2PackageGene2020,
  title = {Gprofiler2 -- an {{R}} Package for Gene List Functional Enrichment Analysis and Namespace Conversion Toolset g:{{Profiler}}.},
  author = {Kolberg, Liis and Raudvere, Uku and Kuzmin, Ivan and Vilo, Jaak and Peterson, Hedi},
