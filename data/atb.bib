  author = {Deng, H. and Liu, R. and Ellmeier, W. and Choe, S. and Unutmaz, D. and Burkhart, M. and Di Marzio, P. and Marmon, S. and Sutton, R.E. and Hill, C.M. and Davis, C.B. and Peiper, S.C. and Schall, T.J. and Littman, D.R. and Landau, N.R.},
