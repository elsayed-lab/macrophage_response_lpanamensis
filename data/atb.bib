  title = {Analysis of Mutations at Residues {{A2451}} and {{G2447}} of {{23S rRNA}} in the Peptidyltransferase Active Site of the {{50S}} Ribosomal Subunit},
  author = {Thompson, J. and Kim, D.F. and O'Connor, M. and Lieberman, K.R. and Bayfield, M.A. and Gregory, S.T. and Green, R. and Noller, H.F. and Dahlberg, A.E.},
