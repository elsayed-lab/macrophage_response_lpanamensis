  pages = {2524--2526},
  issn = {1367-4803},
  doi = {10.1093/bioinformatics/btu305},
  abstract = {Summary: MSstats is an R package for statistical relative quantification of proteins and peptides in mass spectrometry-based proteomics. Version 2.0 of MSstats supports label-free and label-based experimental workflows, and data dependent, targeted and data independent spectral acquisition. It takes as input identified and quantified spectral peaks, and outputs a list of differentially abundant peptides or proteins, or summaries of peptide or protein relative abundance. MSstats relies on a flexible family of linear mixed models.{\textbackslash}nAvailability: The code, the documentation, and example datasets are available open-source at www.msstats.org under the Artistic-2.0 license. The package can be downloaded from www.msstats.org or from Bioconductor www.bioconductor.org, and used in a R command line workflow. The package can also be accessed as an external tool in Skyline (Broudy et al., 2013) and used via graphical user interface.{\textbackslash}nContact: ovitek\{at\}purdue.edu},
  isbn = {1367-4811 (Electronic) 1367-4803 (Linking)},
  pmid = {24794931},
  keywords = {nosource}
}

