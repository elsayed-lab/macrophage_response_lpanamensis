  year = {2007},
  month = may,
  journal = {J.Biol Chem.},
  abstract = {Nucleo-cytoplasmic transport of proteins is mostly mediated by specific interaction between transport receptors of the importin beta-family and signal sequences present in their cargo. While several signal sequences, in particular the classical nuclear localization signal (NLS) recognized by the heterodimeric importin alpha / beta complex are well known, the signals recognized by other importin beta-like transport receptors remain to be characterized in detail. Here we present the systematic analysis of the nuclear import of Saccharomyces cerevisiae Asr1p, a nonessential alcohol-responsive Ring/PHD finger protein that shuttles between nucleus and cytoplasm but accumulates in the nucleus upon alcohol stress. Nuclear import of Asr1p is constitutive and mediated by its C-terminal domain. A short sequence comprising residues},
  keywords = {analysis,CEREVISIAE,COMPLEX,COMPLEXES,Cytoplasm,DOMAIN,La,LOCALIZATION,No DOI found,nosource,Nuclear Localization Signal,protein,Proteins,RESIDUES,Saccharomyces,Saccharomyces cerevisiae,SACCHAROMYCES-CEREVISIAE,sequence,SEQUENCES,SIGNAL,Stress,TRANSPORT,yeast}
