  abstract = {The 20S RNA of Saccharomyces cerevisiae is a single-stranded, circular RNA virus. A previous study suggested that this RNA is part of a 32S ribonucleoprotein particle, being associated with multiple copies of a 23-kilodalton protein. We show here that this protein is, in fact, the chromosome-encoded heat shock protein Hsp26. Furthermore, it is apparently not associated with 20S RNA and plays no obvious role in the life cycle of the virus},
