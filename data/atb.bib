  keywords = {Active Transport,Animals,Carrier Proteins,Carrier Proteins: metabolism,Cell Nucleus,Cell Nucleus: metabolism,Cytoplasm,Cytoplasm: metabolism,Cytoplasmic and Nuclear,Guanosine Triphosphate,Guanosine Triphosphate: metabolism,Hela Cells,Humans,Karyopherins,Karyopherins: metabolism,MicroRNAs,MicroRNAs: chemistry,MicroRNAs: metabolism,nosource,Nucleocytoplasmic Transport Proteins,Oocytes,ran GTP-Binding Protein,ran GTP-Binding Protein: metabolism,Receptors,Recombinant Proteins,Recombinant Proteins: metabolism,Ribonuclease III,Ribonuclease III: metabolism,RNA,RNA Interference,RNA Precursors,RNA Precursors: metabolism,Small Interfering,Small Interfering: metabolism,Xenopus}
