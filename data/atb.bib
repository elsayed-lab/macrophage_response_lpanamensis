@article{sherlockStanfordMicroarrayDatabase2001,
  title = {The {{Stanford Microarray Database}}},
  author = {Sherlock, G and {Hernandez-Boussard}, T and Kasarskis, A and Binkley, G and Matese, J C and Dwight, S S and Kaloper, M and Weng, S and Jin, H and Ball, C A and Eisen, M B and Spellman, P T and Brown, P O and Botstein, D and Cherry, J M},
  year = {2001},
  month = jan,
