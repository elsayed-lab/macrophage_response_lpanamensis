@article{jensenWidespreadVariationTranscript2009,
  title = {Widespread Variation in Transcript Abundance within and across Developmental Stages of {{Trypanosoma}} Brucei.},
  author = {Jensen, Bryan C. and Sivam, Dhileep and Kifer, Charles T. and Myler, Peter J. and Parsons, Marilyn},
