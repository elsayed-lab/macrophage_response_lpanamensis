}

@article{muhlradRecognitionYeastMRNAs1999,
  title = {Recognition of Yeast {{mRNAs}} as "Nonsense Containing" Leads to Both Inhibition of {{mRNA}} Translation and {{mRNA}} Degradation: Implications for the Control of {{mRNA}} Decapping},
