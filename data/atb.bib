@article{rosenbergerALFQRpackageEstimating2014,
  title = {{{ALFQ}}: {{An R-package}} for Estimating Absolute Protein Quantities from Label-Free {{LC-MS}}/{{MS}} Proteomics Data},
  author = {Rosenberger, George and Ludwig, Christina and R{\"o}st, Hannes L. and Aebersold, Ruedi and Malmstr{\"o}m, Lars},
