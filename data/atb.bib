@article{counterCatalyticSubunitYeast1997,
  title = {The Catalytic Subunit of Yeast Telomerase.},
  author = {Counter, C.M. and Meyerson, M. and Eaton, E.N. and Weinberg, R.A.},
  year = {1997},
