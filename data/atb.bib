  title = {Initial Binding of the Elongation Factor {{Tu}}.{{GTP}}.Aminoacyl-{{tRNA}} Complex Preceding Codon Recognition on the Ribosome},
  author = {Rodnina, M.V. and Pape, T. and Fricke, R. and Kuhn, L. and Wintermeyer, W.},
