  keywords = {0,BINDING,Chromosomes,Dna,Electrophoresis,ElectrophoresisGelTwo-Dimensional,Genetic,genetics,Hydrogen-Ion Concentration,La,ModelsMolecular,modification,Molecular Structure,nosource,Plasmids,sequence,structure,Tetrahymena}
