  number = {11},
  eprint = {11080643},
  eprinttype = {pubmed},
  pages = {1215--26},
  issn = {0969-2126},
  abstract = {Polynucleotide phosphorylase (PNPase) is a polyribonucleotide nucleotidyl transferase (E.C.2.7.7.8) that degrades mRNA in prokaryotes. Streptomyces antibioticus PNPase also assays as a guanosine 3'-diphosphate 5'-triphosphate (pppGpp) synthetase (E.C.2.7.6.5). It may function to coordinate changes in mRNA lifetimes with pppGpp levels during the Streptomyces lifecycle.},
