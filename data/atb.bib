@article{tanProgrammedTranslationalFrameshifting2001a,
  title = {Programmed Translational Frameshifting Is Likely Required for Expressions of Genes Encoding Putative Nuclear Protein Kinases of the Ciliate {{Euplotes}} Octocarinatus},
  author = {Tan, M. and Liang, A. and {Brunen-Nieweler}, C. and Heckmann, K.},
