  abstract = {Putting together consistent cryo-EM structure, transient kinetic and mutant tRNA suppressor data, it appears that a deformed or waggling aminoacyl-tRNA is the critical transitional structure examined by the ribosome during decoding at the A site. The unusual conformation may be required for effective proofreading of the codon-anticodon complex},
