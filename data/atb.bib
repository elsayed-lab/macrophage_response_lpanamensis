@article{taylorPracticalApproachRTqPCRPublishing2010,
  title = {A Practical Approach to {{RT-qPCR-Publishing}} Data That Conform to the {{MIQE}} Guidelines.},
  author = {Taylor, Sean and Wakem, Michael and Dijkman, Greg and Alsarraj, Marwan and Nguyen, Marie},
  year = {2010},
