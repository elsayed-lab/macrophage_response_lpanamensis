  keywords = {0,A SITE,A-SITE,Anticodon,ANTICODON LOOP,BASE,BASE-PAIR,BIOLOGY,BOND FORMATION,COMPLEX,COMPLEXES,D,EF-G,efficiency,ELEMENTS,elongation,elongation factors,ELONGATION-FACTOR-G,ELONGATION-FACTORS,Escherichia coli,FE(II),genetics,Hydroxyl Radical,INHIBITOR,La,LOOP,metabolism,Movement,mRNA,nosource,P SITE,P-SITE,P-SITES,peptide bond formation,Peptide Elongation Factor G,Peptide Elongation Factors,REGION,ribosome,Ribosomes,Rna,RNATransfer,SITE,SITES,STEM-LOOP,Structural,structure,supportnon-u.s.gov't,supportu.s.gov'tp.h.s.,T,Thiostrepton,toeprinting,TRANSFER-RNA,translocation,tRNA}
