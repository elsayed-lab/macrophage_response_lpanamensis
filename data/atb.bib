@article{nazar5SRNABinding1979a,
  title = {The 5-{{S RNA}} Binding Protein from Yeast ({{Saccharomyces}} Cerevisiae) Ribosomes. {{Evolution}} of the Eukaryotic 5-{{S RNA}} Binding Protein},
