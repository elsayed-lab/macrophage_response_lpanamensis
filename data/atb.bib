@article{rodninaRecognitionSelectionTRNA2005a,
  title = {Recognition and Selection of {{tRNA}} in Translation},
  author = {Rodnina, M.V. and Gromadski, K.B. and Kothe, U. and Wieden, H.J.},
  year = {2005},
