  keywords = {Bacteria,Bacteria: genetics,Computer Simulation,DNA Transposable Elements,DNA Transposable Elements: genetics,High-Throughput Nucleotide Sequencing,High-Throughput Nucleotide Sequencing: methods,nosource,RNA,RNA: methods,Sequence Analysis,Transcriptome,Transcriptome: genetics}
