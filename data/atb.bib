@article{gottesfeldAssemblyTranscriptionallyActive1982a,
  title = {Assembly of Transcriptionally Active {{5S RNA}} Gene Chromatin in Vitro},
  author = {Gottesfeld, J. and Bloomer, L.S.},
  year = {1982},
