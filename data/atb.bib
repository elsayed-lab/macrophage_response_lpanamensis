@article{kobayashiExpansionContractionRibosomal1998a,
  title = {Expansion and Contraction of Ribosomal {{DNA}} Repeats in {{Saccharomyces}} Cerevisiae: Requirement of Replication Fork Blocking ({{Fob1}}) Protein and the Role of {{RNA}} Polymerase {{I}}},
  author = {Kobayashi, T. and Heck, D.J. and Nomura, M. and Horiuchi, T.},
