  doi = {10.1139/o95-094},
  abstract = {5S rRNA is a small RNA molecule that is a component of a ribosome from almost all living organisms. In this review, we discuss the biogenesis of 5S rRNA and its properties as an independent structural domain of a ribosome as well as the current concepts concerning the higher order structure of 5S rRNA in free state and in its complexes with ribosomal proteins and its folding in the ribosome. Special attention is paid to recent experimental approaches that have been useful in 5S rRNA studies. Our own data on topography of 5S rRNA in the ribosomes are discussed in detail. The hypothesis describing the possible functional role of 5S rRNA for ribosome functioning is discussed},
