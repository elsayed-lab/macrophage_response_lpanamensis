@article{dragicHIV1EntryCD41996a,
  title = {{{HIV-1}} Entry into {{CD4}}+ Cells Is Mediated by the Chemokine Receptor {{CC-CKR-5}}},
  author = {Dragic, T. and Litwin, V. and Allaway, G.P. and Martin, S.R. and Huang, Y. and Nagashima, K.A. and Cayanan, C. and Maddon, P.J. and Koup, R.A. and Moore, J.P. and Paxton, W.A.},
