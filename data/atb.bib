  keywords = {Complementary,Complementary: chemistry,Databases,DNA,Expressed Sequence Tags,Expressed Sequence Tags: chemistry,Genomics,Internet,National Library of Medicine (U.S.),nosource,Nucleic Acid,Sequence Analysis,United States,User-Computer Interface}
